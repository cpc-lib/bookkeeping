            "description": "注册账号, 成功后直接返回双 Token, 无需二次登录。\n\n**请求参数(JSON)**\n| 字段 | 类型 | 必填 | 说明 |\n| --- | --- | --- | --- |\n| username | string | 是 | 3-20位字母、数字或下划线 |\n| password | string | 是 | 6-20位 |\n| nickname | string | 是 | 昵称, 最长20字符 |\n\n**错误码**: 1001 用户名已被注册"
          },
          "response": [
            {
              "name": "注册成功",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"test_user\",\n  \"password\": \"123456\",\n  \"nickname\": \"测试用户\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/register",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "register"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"code\": 0,\n  \"msg\": \"success\",\n  \"data\": {\n    \"accessToken\": \"eyJhbGciOiJIUzI1NiJ9...\",\n    \"refreshToken\": \"eyJhbGciOiJIUzI1NiJ9...\",\n    \"accessExpire\": 7200,\n    \"refreshExpire\": 604800,\n    \"userInfo\": {\n      \"id\": 1,\n      \"username\": \"test_user\",\n      \"nickname\": \"测试用户\",\n      \"avatar\": null\n    }\n  }\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  console.log('Token 已自动保存到集合变量');",
                  "}"
                ]
              }
            }
